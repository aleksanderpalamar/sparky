
pkgbase=sparky
pkgname=(sparky sparky-wallpapers)
pkgver=0.26.0
pkgrel=1
pkgdesc='Ambiente de desktop Wayland em Rust, com compositor próprio em mosaico e feito para o teclado'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=(
  'gcc-libs'
  'glibc'
  'glib2'
  'libdrm'
  'libglvnd'
  'libinput'
  'libnotify'
  'libpulse'
  'libxkbcommon'
  'mesa'
  'polkit'
  'pipewire'
  'seatd'
  'systemd-libs'
  'util-linux'
  'wayland'
  'wl-clipboard'
  'xdg-utils'
  'xdg-desktop-portal'
  'xdg-desktop-portal-gtk'
  'xdg-desktop-portal-wlr>=0.8.4'
  'xkeyboard-config'
  'xorg-xwayland'
  'zsh'
  'zsh-autosuggestions'
  'zsh-syntax-highlighting'
)
makedepends=('cargo' 'git')
backup=('etc/xdg/xdg-desktop-portal-wlr/sparky')
optdepends=(
  'pipewire-pulse: controle de som dos painéis da bandeja via PipeWire'
  'networkmanager: controle de rede no painel da bandeja'
  'bluez: controle e pareamento Bluetooth no painel da bandeja'
  'udisks2: montar e desmontar volumes no painel e no gerenciador de arquivos'
  'gvfs-mtp: acessar smartphones Android por MTP no gerenciador de arquivos'
  'swaylock: tela de bloqueio padrão do SUPER + CTRL + L'
  'foot: terminal'
  'kitty: terminal'
  'vulkan-icd-loader: renderização por Vulkan nos aplicativos'
  'ttf-jetbrains-mono-nerd: fonte da barra, das abas e dos aplicativos'
  'ttf-liberation: fontes com e sem serifa'
  'noto-fonts: letras dos outros idiomas'
  'noto-fonts-emoji: emoji'
  'noto-fonts-cjk: chinês, japonês e coreano'
  'woff2-font-awesome: ícones em forma de letra'
  'yaru-icon-theme: ícones de cada tema (AUR)'
  'fzf: busca no histórico e em arquivos dentro do sparky-terminal'
  'autojump: pular para pastas já visitadas no sparky-terminal'
)
source=("$pkgbase::git+file://$(realpath "$startdir/../..")#commit=$(git -C "$startdir/../.." rev-parse HEAD)")
sha256sums=('SKIP')

prepare() {
  cd "$pkgbase"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgbase"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace
}

check() {
  cd "$pkgbase"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --workspace
}

package_sparky() {
  cd "$pkgbase"
  local binary
  for binary in sparky sparky-bar sparky-msg sparky-shot sparky-files sparky-settings sparky-launcher sparky-keyring sparky-keyring-prompt sparky-terminal sparky-notifications polkit-sparky; do
    install -Dm755 "target/release/$binary" -t "$pkgdir/usr/bin"
  done
  install -Dm644 data/session/sparky.desktop -t "$pkgdir/usr/share/wayland-sessions"
  install -Dm644 data/portals/sparky-portals.conf -t "$pkgdir/usr/share/xdg-desktop-portal"
  install -Dm644 data/portals/sparky-wlr.conf "$pkgdir/etc/xdg/xdg-desktop-portal-wlr/sparky"
  install -Dm644 data/portals/sparky-keyring.portal -t "$pkgdir/usr/share/xdg-desktop-portal/portals"
  install -Dm644 data/applications/* -t "$pkgdir/usr/share/applications"
  local file
  for file in data/themes/*/*; do
    install -Dm644 "$file" "$pkgdir/usr/share/sparky/${file#data/}"
  done
  install -Dm644 data/config/sparky.toml -t "$pkgdir/usr/share/sparky"
  install -Dm644 data/zsh/.zshenv data/zsh/.zshrc data/zsh/completion.zsh data/zsh/extras.zsh data/zsh/git.zsh data/zsh/keys.zsh data/zsh/options.zsh data/zsh/plugins.zsh data/zsh/prompt.zsh data/zsh/vcs.zsh data/zsh/web.zsh -t "$pkgdir/usr/share/sparky/zsh"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/SCREENCAST.md -t "$pkgdir/usr/share/doc/$pkgname/docs"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_sparky-wallpapers() {
  pkgdesc='Papéis de parede dos temas do sparky'
  arch=('any')
  depends=('sparky')
  optdepends=()
  backup=()
  cd "$pkgbase"
  local file
  for file in data/wallpapers/*/*; do
    install -Dm644 "$file" "$pkgdir/usr/share/sparky/${file#data/}"
  done
}
